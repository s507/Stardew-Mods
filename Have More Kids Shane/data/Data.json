{
    "Changes": [
        {
            //  load all the child's texture
            // all characters use Lumisteria "Toddlers like parents"
            "LogName": "baby textures",
            "Action": "Load",
            "Target": "{{ModId}}/baby/{{L@Kid}}",
            "FromFile": "assets/characters/{{L@Kid}}/baby.png"
        },
        {
            "LogName": "characters",
            "Action": "Load",
            "Target": "{{ModId}}/characters/{{L@Kid}}/spring, {{ModId}}/characters/{{L@Kid}}/summer, {{ModId}}/characters/{{L@Kid}}/fall, {{ModId}}/characters/{{L@Kid}}/winterIndoors, {{ModId}}/characters/{{L@Kid}}/winterOutdoors",
            "FromFile": "assets/characters/{{L@Kid}}/{{TargetWithoutPath}}.png"
        },
        {
            // all portraits made using Nyapu's "The Farmer's Children Art" file from "Nyapu's Portraits inspired by Dong" 
            "LogName": "portraits",
            "Action": "Load",
            "Target": "{{ModId}}/portraits/{{L@Kid}}/spring, {{ModId}}/portraits/{{L@Kid}}/summer, {{ModId}}/portraits/{{L@Kid}}/fall, {{ModId}}/portraits/{{L@Kid}}/winterIndoors, {{ModId}}/portraits/{{L@Kid}}/winterOutdoors",
            "FromFile": "assets/portraits/{{L@Kid}}/{{TargetWithoutPath}}.png"
        },
        {
            "LogName": "festival characters",
            "Action": "Load",
            "Target": "{{ModId}}/characters/{{L@Kid}}/SpiritEve, {{ModId}}/characters/{{L@Kid}}/WinterStar, {{ModId}}/characters/{{L@Kid}}/FlowerDance, {{ModId}}/characters/{{L@Kid}}/Luau",
            "FromFile": "assets/characters/{{L@Kid}}/Festivals/{{TargetWithoutPath}}.png"
        },
        {
            "LogName": "festival portraits",
            "Action": "Load",
            "Target": "{{ModId}}/portraits/{{L@Kid}}/SpiritEve, {{ModId}}/portraits/{{L@Kid}}/WinterStar, {{ModId}}/portraits/{{L@Kid}}/FlowerDance, {{ModId}}/portraits/{{L@Kid}}/Luau",
            "FromFile": "assets/portraits/{{L@Kid}}/Festivals/{{TargetWithoutPath}}.png"
        },
        {
            //  child data
            "LogName": "gives the kids to shane",
            "Action": "EditData",
            "Target": "mushymato.HaveMoreKids/Kids",
            "Entries": {
                "{{ModId}}_{{L@kid}}": {
                    "Parent": "Shane",
                    "RoamOnFarmCondition": "!WEATHER Farm GreenRain Rain Snow Storm"
                }
            }
        },
        {
            // npc data
            "Action": "EditData",
            "Target": "mushymato.HaveMoreKids/ChildData",
            "Entries": {
                "{{ModId}}_{{L@Kid}}": {
                    "DisplayName": "{{i18n:{{L@Kid}}.DisplayName}}",
                    "Gender": "{{L@Gender}}",
                    "IsNPCTodayCondition": "True",
                    "Home": [
                        {
                            "Id": "default",
                            "Location": "BusStop",
                            "Tile": {
                                "X": "{{HomeTileX}}",
                                "Y": "{{HomeTileY}}"
                            },
                            "Direction": "right"
                        }
                    ],
                    "Appearance": [
                        //  baby 
                        {
                            "Id": "HMK_BABY_{{L@Kid}}",
                            "Sprite": "{{ModId}}/baby/{{L@Kid}}"
                        },
                        //  spring 
                        {
                            "Id": "{{ModId}}_Toddler_{{L@Kid}}_spring",
                            "Sprite": "{{ModId}}/characters/{{L@Kid}}/spring",
                            "Portrait": "{{ModId}}/portraits/{{L@Kid}}/spring"
                        },
                        //  summer 
                        {
                            "Id": "{{ModId}}_Toddler_{{L@Kid}}_summer",
                            "Sprite": "{{ModId}}/characters/{{L@Kid}}/summer",
                            "Portrait": "{{ModId}}/portraits/{{L@Kid}}/summer",
                            "Season": "Summer",
                            "Precedence": -1
                        },
                        //  fall 
                        {
                            "Id": "{{ModId}}_Toddler_{{L@Kid}}_fall",
                            "Sprite": "{{ModId}}/characters/{{L@Kid}}/fall",
                            "Portrait": "{{ModId}}/portraits/{{L@Kid}}/fall",
                            "Season": "Fall",
                            "Precedence": -1
                        },
                        //  indoor winter 
                        {
                            "Id": "{{ModId}}_Toddler_{{L@Kid}}_winterIndoors",
                            "Sprite": "{{ModId}}/characters/{{L@Kid}}/winterIndoors",
                            "Portrait": "{{ModId}}/portraits/{{L@Kid}}/winterIndoors",
                            "Season": "Winter",
                            "Outdoors": false,
                            "Precedence": -1
                        },
                        //  outdoor winter 
                        {
                            "Id": "{{ModId}}_Toddler_{{L@Kid}}_winterOutdoors",
                            "Sprite": "{{ModId}}/characters/{{L@Kid}}/winterOutdoors",
                            "Portrait": "{{ModId}}/portraits/{{L@Kid}}/winterOutdoors",
                            "Season": "Winter",
                            "Indoors": false,
                            "Precedence": -1
                        },
                        // ⸻⸻⸻⸻⸻ //
                        /// FESTIVALS 
                        // egg festival
                        // >>> spring13
                        // flower dance
                        {
                            "Id": "{{ModId}}_Toddler_{{L@Kid}}_FlowerDance",
                            "Sprite": "{{ModId}}/characters/{{L@Kid}}/FlowerDance",
                            "Portrait": "{{ModId}}/portraits/{{L@Kid}}/FlowerDance",
                            "Condition": "IS_EVENT festival_spring24",
                            "Precedence": -10
                        },
                        // ⸻⸻⸻⸻⸻ //
                        // luau
                        {
                            "Id": "{{ModId}}_Toddler_{{L@Kid}}_Luau",
                            "Sprite": "{{ModId}}/characters/{{L@Kid}}/Luau",
                            "Portrait": "{{ModId}}/portraits/{{L@Kid}}/Luau",
                            "Condition": "IS_EVENT festival_summer11",
                            "Precedence": -10
                        },
                        // dance of the moonlight jellies
                        // >>> summer28
                        // ⸻⸻⸻⸻⸻ //
                        // stardew valley fair
                        // >>> fall16
                        // spirit's eve
                        {
                            "Id": "{{ModId}}_Toddler_{{L@Kid}}_SpiritEve",
                            "Sprite": "{{ModId}}/characters/{{L@Kid}}/SpiritEve",
                            "Portrait": "{{ModId}}/portraits/{{L@Kid}}/SpiritEve",
                            "Condition": "IS_EVENT festival_fall27",
                            "Precedence": -10
                        },
                        // ⸻⸻⸻⸻⸻ //s
                        // festival of ice
                        // >>> winter8
                        // feast of the winter star
                        {
                            "Id": "{{ModId}}_Toddler_{{L@Kid}}_WinterStar",
                            "Sprite": "{{ModId}}/characters/{{L@Kid}}/WinterStar",
                            "Portrait": "{{ModId}}/portraits/{{L@Kid}}/WinterStar",
                            "Condition": "IS_EVENT festival_winter25",
                            "Precedence": -10
                        }
                    ]
                }
            }
        }
    ]
}