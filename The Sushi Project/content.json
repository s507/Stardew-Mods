{
    "Format": "2.6.0",
    "ConfigSchema": {
        "ColorScheme": {
            "AllowValues": "Vanilla, Desaturated",
            "Default": "Vanilla",
            "Section": "Visuals"
        },
        "BookStyle": {
            "AllowValues": "Vanilla, VT",
            "Default": "Vanilla",
            "Section": "Visuals"
        },
        "SushiLetterFrequency": {
            "AllowValues": "Once, Weekly, Monthly",
            "Default": "Once"
        },
        "Frog": {
            "AllowValues": "True, False",
            "Default": "True",
            "Section": "Shop"
        },
        "ItemPriceModifier": {
            "AllowValues": "1, 2",
            "Default": "2",
            "Section": "Balance"
        },
        "RecipePriceModifier": {
            "AllowValues": "1, 2",
            "Default": "2",
            "Section": "Balance"
        },
        "DishEdibility": {
            "AllowValues": "Original, Balanced",
            "Default": "Original",
            "Section": "Balance"
        }
    },
    "DynamicTokens": [
        {
            // Set the frequency of the sushi letter 
            "Name": "SushiCondition",
            "Value": "DAY_OF_WEEK Tuesday"
        },
        {
            "Name": "SushiCondition",
            "Value": "DAY_OF_MONTH 2",
            "When": {
                "SushiLetterFrequency": "Monthly"
            }
        },
        {
            // Determines whenever the shop is open (Approved by Kailey) ♡
            "Name": "ShopStatus",
            "Value": "Open"
        },
        {
            "Name": "ShopStatus",
            "Value": "Closed",
            "When": {
                "Time": "{{Range: 2010, 2600}}"
            }
        },
        {
            // Letter content that change the letter if it's repeatable (ignored if the letter isn't)
            "Name": "LetterContent",
            "Value": "{{i18n:sushi_stall.mail.content_repeat}}"
        },
        {
            "Name": "LetterContent",
            "Value": "{{i18n:sushi_stall.mail.content_first}} %item id (O){{ModId}}_Aji 1%%",
            "When": {
                "Day": "2",
                "Season": "Spring",
                "Year": "1"
            }
        },
        {
            // Soy Sauce added by the mod is replace when Cornucopia - Artisan Machines is installed, for simplifying purposes 
            "Name": "SoySauce",
            "Value": "{{ModId}}_Soy_Sauce"
        },
        {
            "Name": "SoySauce",
            "Value": "Cornucopia_SoySauce",
            "When": {
                "HasMod": "Cornucopia.ArtisanMachines"
            }
        },
        {
            // Frog Vendor Mayhap
            "Name": "Vendor",
            "Value": "Generic"
        },
        {
            "Name": "Vendor",
            "Value": "Frog",
            "When": {
                "Random: {{Range: 1, 20}}": 1,
                "Frog": true
            }
        },
        {
            // Book Visuals 
            "Name": "BookVisual",
            "Value": "0"
        },
        {
            "Name": "BookVisual",
            "Value": "1",
            "When": {
                "BookStyle": "VT"
            }
        }
    ],
    "Changes": [
        {
            // Adds the new sushi stall tilesheets as maps.
            "LogName": "Load Stall Tilesheets",
            "Action": "Load",
            "Target": "Maps/spring_SushiStall, Maps/summer_SushiStall, Maps/fall_SushiStall, Maps/winter_SushiStall, Maps/SushiStall_OpenGeneric, Maps/SushiStall_OpenFrog",
            "FromFile": "Assets/Tilesheets/{{ColorScheme}}/{{TargetWithoutPath}}.png"
        },
        {
            // Edits the tilesheets for the sushi shop when it's open
            "LogName": "Sushi Open/Closed edit",
            "Action": "EditImage",
            "Target": "Maps/{{season}}_SushiStall",
            "FromFile": "Assets/Tilesheets/{{ColorScheme}}/SushiStall_Open{{Vendor}}.png",
            "PatchMode": "Overlay",
            "Update": "OnTimeChange",
            "When": {
                "ShopStatus": "Open"
            }
        },
        {
            // Adds the stall to the forest! 
            // Note because it's an outdoors map and all the tilesheets have seasonal names (spring_, summer_ etc) the seasonal variants will change automatically. which is very cool 10/10
            "LogName": "Adds the stall to the forest",
            "Action": "EditMap",
            "Target": "Maps/Forest",
            "PatchMode": "Overlay",
            "FromFile": "assets/Maps/Bea_SushiStall.tmx",
            "ToArea": {
                "X": 48,
                "Y": 69,
                "Width": 4,
                "Height": 5
            },
            "When": {
                "DayOfWeek": "Tuesday, Saturday"
            },
            "Priority": "Late"
        },
        {
            "Action": "EditData",
            "Target": "Data/TriggerActions",
            "Entries": {
                // clear the map so stuff doesn't grow inside and around the stall
                "{{ModId}}_Clear_That_Terrain!": {
                    "Id": "{{ModId}}_Clear_That_Terrain!",
                    "Trigger": "DayStarted",
                    "Condition": "DAY_OF_WEEK Tuesday Saturday",
                    "Actions": [
                        "Spiderbuttons.BETAS_ClearTerrainFeatures Forest !Grass 46 70 54 75",
                        "Spiderbuttons.BETAS_ClearTerrainFeatures Forest Grass 47 71 52 74"
                    ]
                },
                // un-does trigger action to save me from myself, really
                "{{ModId}}_Unclear_That_Terrain": {
                    "Id": "{{ModId}}_Unclear_That_Terrain",
                    "Trigger": "DayStarted",
                    "Condition": "!DAY_OF_WEEK Tuesday Saturday",
                    "Actions": [
                        "MarkActionApplied Current {{ModId}}_Clear_That_Terrain! false"
                    ]
                }
            }
        },
        {
            // Lets the game load additional (not in content.json) content files 
            "LogName": "Object Item Data",
            "Action": "Include",
            "FromFile": "Data/Objects_{{DishEdibility}}.json, Data/CookingRecipes.json, Data/NPCGiftTastes.json"
        },
        {
            "LogName": "Include Shop Data",
            "Action": "Include",
            "FromFile": "Data/Shops.json"
        },
        {
            "LogName": "Include Mail & Book Data",
            "Action": "Include",
            "FromFile": "Data/Mail.json, Data/Book.json"
        }
    ]
}